{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gmail-multi-mcp",
  "main": "worker/index.ts",
  // Records the commit being deployed (shown on the setup page and at /version) before every bundle.
  "build": { "command": "node worker/write-version.mjs" },
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Created automatically on the first deploy.
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "observability": { "enabled": true },
  // Smaller bundle (about a quarter less compressed); startup time is unchanged either way.
  "minify": true,
  // Keep variables set in the Cloudflare dashboard (e.g. ALLOWED_EMAILS) when redeploying.
  "keep_vars": true,
  "workers_dev": true
}
